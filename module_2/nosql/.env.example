# Standalone MongoDB
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=example
MONGO_INITDB_DATABASE=appdb
MONGO_APP_USERNAME=appuser
MONGO_APP_PASSWORD=apppassword

# Python application defaults
APP_MONGO_URI=mongodb://localhost:27018/appdb
APP_MONGO_DB=appdb

# Optional seed sizing
TEACHERS_COUNT=5
STUDENTS_COUNT=50
COURSES_COUNT=8
GRADES_PER_STUDENT_MIN=2
GRADES_PER_STUDENT_MAX=4
